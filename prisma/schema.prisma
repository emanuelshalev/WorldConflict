// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id           String   @id @default(uuid())
  name         String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SaveGame {
  id          String   @id @default(uuid())
  name        String
  worldState  String   // JSON serialized WorldState
  playerCountry String
  playerId    String?  // owning player account
  leaderName  String?  // how the player is addressed in this game
  llmUsage    String?  // JSON UsageTotals: cumulative LLM tokens/cost for this save
  seed        Int
  turn        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TurnLog {
  id         String   @id @default(uuid())
  saveGameId String
  turn       Int
  events     String   // JSON serialized events
  actions    String   // JSON serialized actions
  createdAt  DateTime @default(now())
}

// A finished session's result: personal history and per-seat rankings (GET /api/runs)
model RunResult {
  id           String   @id @default(uuid())
  saveId       String   @unique
  playerId     String?  // account, when signed in
  guestId      String?  // the browser's guest id otherwise
  seatKey      String   // "flashpointId:side" or "scenario:mode:country"
  difficulty   String
  seed         Int
  score        Int      // Presidency Score, 0-1000
  grade        String
  stars        Int
  verdict      String
  parts        String   // JSON [mission, timing, leadership, finish]
  achievements String   // JSON string[]
  detail       String?  // JSON { seedCode, series, choices, aiTier } for Compare runs
  createdAt    DateTime @default(now())

  @@index([seatKey, score])
}
