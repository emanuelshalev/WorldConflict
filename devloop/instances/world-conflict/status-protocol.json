{
  "page": "dev_plan/project_status.html",
  "tabSelector": "#tabs button",
  "sections": [
    { "id": "progress",   "tab": "Iterations (stepper)",               "tier": "T0", "source": "generated", "from": "progress/stages.jsonl", "injector": "progress.mjs --inject PROGRESS" },
    { "id": "loop-state", "tab": "Iterations (header)",                "tier": "T0", "source": "generated", "from": "loop/state.json", "fields": ["LOOP.updated", "LOOP.iteration", "LOOP.stage"] },
    { "id": "now",        "tab": "Iterations (Now)",                   "tier": "T1", "source": "hand", "fields": ["LOOP.now"] },
    { "id": "iter-current","tab": "Iterations (current iteration)",    "tier": "T1", "source": "hand", "fields": ["LOOP.iterations[current].highlights", "LOOP.iterations[current].lowlights"] },
    { "id": "kpis",       "tab": "Iterations (KPI cards)",             "tier": "T1", "source": "generated", "from": "sessions, ledger, real-signals, registry" },
    { "id": "tasks",      "tab": "Development Status",                 "tier": "T1", "source": "generated", "from": "runs/iter-NN work packages and ledger" },
    { "id": "blockers",   "tab": "Blockers",                           "tier": "T1", "source": "generated", "from": "loop/state.json blocked items and open S1/S2" },
    { "id": "decisions",  "tab": "Decision Points",                    "tier": "T1", "source": "generated", "from": "ledger.md (open rows, owner decisions)" },
    { "id": "stability",  "tab": "Iterations (stability)",             "tier": "T1", "source": "generated", "from": "regressions.yaml and .verify logs" },
    { "id": "feedback",   "tab": "Iterations (feedback browser)",      "tier": "T2", "source": "generated", "from": "runs/iter-NN/sessions, patterns.json", "injector": "feedback-digest.mjs --inject FEEDBACK" },
    { "id": "heat",       "tab": "Iterations (recommend by persona)",  "tier": "T2", "source": "generated", "from": "FEEDBACK (built in the page)" },
    { "id": "gate",       "tab": "Iterations (release gate)",          "tier": "T2", "source": "generated", "from": "goals.md gate and the quality scorecard (D-78)" },
    { "id": "iter-summary","tab": "Iterations (iteration summary)",    "tier": "T2", "source": "hand", "fields": ["LOOP.iterations[current].summary"] },
    { "id": "usage",      "tab": "Consumption",                        "tier": "T3", "source": "generated", "from": "transcripts via usage/registry.json", "injector": "usage-ledger.mjs --inject USAGE" },
    { "id": "goals",      "tab": "Iterations (goals)",                 "tier": "T3", "source": "generated", "from": "goals.md" },
    { "id": "timeline",   "tab": "Plan Overview",                      "tier": "T3", "source": "generated", "from": "iterations and tags" },
    { "id": "journal",    "tab": "Journal",                            "tier": "T3", "source": "generated", "from": "journal.md" },
    { "id": "personas",   "tab": "Personas",                           "tier": "T4", "source": "generated", "from": "panel/*.yaml (panel version)" },
    { "id": "how",        "tab": "How we work",                        "tier": "T4", "source": "generated", "from": "devloop/HOW_WE_WORK.md (version)" },
    { "id": "arch",       "tab": "Architecture",                       "tier": "T4", "source": "hand", "fields": ["STATUS.modules"] }
  ]
}
