{
  "page": "dev_plan/project_status.html",
  "tabSelector": "#tabs button",
  "loopConfig": "loop/config.json",
  "tierEvents": {
    "T0": [{ "loop": ["init", "transition", "progress"] }],
    "T1": [{ "loop": ["merge", "publish", "block", "unblock"] }, { "gitMerges": true }],
    "T2": [{ "loopTransitionFrom": ["Use", "Triage"] }, { "gitPaths": ["real-signals"] }],
    "T3": [{ "loopTransitionFrom": ["Gate"] }],
    "T4": []
  },
  "sections": [
    { "id": "progress",   "tab": "Iterations (stepper)",               "tier": "T0", "source": "generated", "from": "progress/stages.jsonl", "injector": "progress.mjs --inject PROGRESS", "el": "progressbox",
      "run": ["node", "devloop/kit/progress.mjs", "devloop/instances/world-conflict/progress/config.json", "--inject", "{page}", "PROGRESS"] },
    { "id": "loop-state", "tab": "Iterations (header)",                "tier": "T0", "source": "generated", "from": "loop/state.json", "fields": ["LOOP.updated", "LOOP.iteration", "LOOP.stage"], "el": "iterlabel",
      "gen": { "kind": "loop" } },
    { "id": "now",        "tab": "Iterations (Now)",                   "tier": "T1", "source": "hand", "fields": ["LOOP.now"], "el": "nowbox" },
    { "id": "iter-current","tab": "Iterations (current iteration)",    "tier": "T1", "source": "hand", "fields": ["LOOP.iterations[current].highlights", "LOOP.iterations[current].lowlights"], "el": "iterpills" },
    { "id": "kpis",       "tab": "Iterations (KPI cards)",             "tier": "T1", "source": "generated", "from": "sessions, ledger, real-signals, registry", "el": "loopkpis",
      "gen": { "kind": "kpis", "items": [
        { "label": "Iteration", "kind": "iteration" },
        { "label": "Customer personas", "kind": "count", "dir": "panel", "match": "\\.yaml$", "exclude": "^panel\\.yaml$" },
        { "label": "Team personas", "kind": "count", "dir": "team", "match": "\\.md$", "exclude": "^README\\.md$" },
        { "label": "Real signals", "kind": "count", "dir": "real-signals", "match": "^RS-\\d+", "small": "CEO" },
        { "label": "Recommend", "kind": "feedback", "field": "recommend" },
        { "label": "Decisions logged", "kind": "ledger-last", "from": "ledger.md" },
        { "label": "Guarded findings", "kind": "stability" },
        { "label": "Release gate", "kind": "text", "value": "<span style='color:var(--brand)'>not met</span>" }
      ] } },
    { "id": "tasks",      "tab": "Development Status",                 "tier": "T1", "source": "generated", "from": "runs/iter-NN work packages and ledger", "el": "taskrows",
      "gen": { "kind": "tasks", "from": "runs/iter-{NN}/work-packages.json" } },
    { "id": "blockers",   "tab": "Blockers",                           "tier": "T1", "source": "generated", "from": "loop/state.json blocked items and open S1/S2", "el": "blockrows",
      "gen": { "kind": "blockers" } },
    { "id": "decisions",  "tab": "Decision Points",                    "tier": "T1", "source": "generated", "from": "ledger.md (open rows, owner decisions)", "el": "decisionlist",
      "gen": { "kind": "ledger", "from": "ledger.md", "open": ["Open", "Draft"] } },
    { "id": "stability",  "tab": "Iterations (stability)",             "tier": "T1", "source": "generated", "from": "regressions.yaml and .verify logs", "el": "loopkpis",
      "gen": { "kind": "stability", "registry": "regressions.yaml", "summary": ".verify/summary.json" } },
    { "id": "feedback",   "tab": "Iterations (feedback browser)",      "tier": "T2", "source": "generated", "from": "runs/iter-NN/sessions, patterns.json", "injector": "feedback-digest.mjs --inject FEEDBACK", "el": "iterdetail",
      "run": ["node", "devloop/kit/feedback-digest.mjs", "devloop/instances/world-conflict", "0", "--inject", "{page}", "FEEDBACK"] },
    { "id": "heat",       "tab": "Iterations (recommend by persona)",  "tier": "T2", "source": "generated", "from": "FEEDBACK (built in the page)", "derivedFrom": "feedback", "el": "heat" },
    { "id": "gate",       "tab": "Iterations (release gate)",          "tier": "T2", "source": "generated", "from": "gate.md and the quality scorecard (D-78)", "el": "gate",
      "gen": { "kind": "bullets", "from": "gate.md" } },
    { "id": "iter-summary","tab": "Iterations (iteration summary)",    "tier": "T2", "source": "hand", "fields": ["LOOP.iterations[current].summary"], "el": "iterdetail" },
    { "id": "usage",      "tab": "Consumption",                        "tier": "T3", "source": "generated", "from": "transcripts via usage/registry.json", "injector": "usage-ledger.mjs --inject USAGE", "el": "utiles",
      "run": ["node", "devloop/kit/usage-ledger.mjs", "devloop/instances/world-conflict/usage/registry.json", "--inject", "{page}", "USAGE"] },
    { "id": "goals",      "tab": "Iterations (goals)",                 "tier": "T3", "source": "generated", "from": "goals.md", "el": "goalrows",
      "gen": { "kind": "goals", "from": "goals.md" } },
    { "id": "timeline",   "tab": "Plan Overview",                      "tier": "T3", "source": "generated", "from": "iterations and tags", "el": "timeline" },
    { "id": "journal",    "tab": "Journal",                            "tier": "T3", "source": "generated", "from": "journal.md", "el": "journallist",
      "gen": { "kind": "journal", "from": "journal.md" } },
    { "id": "personas",   "tab": "Personas",                           "tier": "T4", "source": "generated", "from": "panel/*.yaml (panel version)", "el": "customers",
      "events": [{ "gitPaths": ["panel", "team"] }] },
    { "id": "how",        "tab": "How we work",                        "tier": "T4", "source": "generated", "from": "devloop/HOW_WE_WORK.md (version)", "el": "principles",
      "gen": { "kind": "how", "from": "../../HOW_WE_WORK.md" }, "events": [{ "gitPaths": ["../../HOW_WE_WORK.md"] }] },
    { "id": "arch",       "tab": "Architecture",                       "tier": "T4", "source": "hand", "fields": ["STATUS.modules"], "el": "modules",
      "events": [{ "gitPaths": ["../../../docs/ARCHITECTURE.md"] }] }
  ]
}
