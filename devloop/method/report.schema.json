{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic customer session report",
  "type": "object",
  "required": [
    "persona",
    "variant",
    "panel_version",
    "build",
    "iteration",
    "scenarios",
    "friction",
    "bugs",
    "suggestions",
    "scores",
    "quit_point",
    "verbatim"
  ],
  "properties": {
    "persona": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "device": {
      "type": "string",
      "description": "the device and screen this session was played on (the persona variant's own device unless the brief says otherwise)"
    },
    "panel_version": {
      "type": "string"
    },
    "build": {
      "type": "string",
      "description": "git short hash of the build played"
    },
    "iteration": {
      "type": "integer"
    },
    "minutes_played": {
      "type": "number"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "outcome",
          "steps",
          "turns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "achieved",
              "partial",
              "abandoned"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "turns": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "friction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "where",
          "expected",
          "happened",
          "kind"
        ],
        "properties": {
          "where": {
            "type": "string",
            "description": "screen and element"
          },
          "expected": {
            "type": "string"
          },
          "happened": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "hesitation",
              "misread",
              "retry",
              "backtrack",
              "blocked",
              "dashboard-feel",
              "naming",
              "parity",
              "other",
              "affordance",
              "trust",
              "layout"
            ]
          },
          "screenshot": {
            "type": "string"
          }
        }
      }
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "steps",
          "expected",
          "actual",
          "severity"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          },
          "screenshot": {
            "type": "string"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "goal_served"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "goal_served": {
            "type": "string"
          }
        }
      }
    },
    "delight": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "short positive moments (kept for older reports; new reports also fill liked)"
    },
    "liked": {
      "type": "array",
      "description": "what this customer liked, as carefully as friction is recorded: read by the Customer Advocate to build the keep list and to predict reactions to changes (method/customer-advocate.md)",
      "items": {
        "type": "object",
        "required": [
          "what",
          "where",
          "why",
          "strength",
          "would_miss"
        ],
        "properties": {
          "what": {
            "type": "string",
            "description": "the thing itself, named as it appears on screen"
          },
          "where": {
            "type": "string",
            "description": "screen and element, and the moment (which month, after what)"
          },
          "why": {
            "type": "string",
            "description": "what it gave this person: in their own words"
          },
          "strength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = nice touch, 3 = a reason to keep playing, 5 = the reason I would tell someone about this"
          },
          "would_miss": {
            "type": "boolean",
            "description": "would this person notice and mind if it were gone or changed"
          },
          "screenshot": {
            "type": "string"
          }
        }
      }
    },
    "would_miss_most": {
      "type": [
        "string",
        "null"
      ],
      "description": "the one thing this person would miss most if it were removed, or null"
    },
    "pull_to_continue": {
      "type": [
        "string",
        "null"
      ],
      "description": "what made this person want to play one more month or one more game, at the moment it happened; null if nothing did"
    },
    "scores": {
      "type": "object",
      "required": [
        "fun",
        "clarity",
        "visual",
        "feels_like_a_game",
        "agency",
        "realism",
        "replay",
        "recommend"
      ],
      "properties": {
        "fun": {
          "$ref": "#/$defs/score"
        },
        "clarity": {
          "$ref": "#/$defs/score"
        },
        "visual": {
          "$ref": "#/$defs/score"
        },
        "feels_like_a_game": {
          "$ref": "#/$defs/score"
        },
        "agency": {
          "$ref": "#/$defs/score",
          "description": "never felt blocked without knowing why"
        },
        "realism": {
          "$ref": "#/$defs/score"
        },
        "replay": {
          "$ref": "#/$defs/score"
        },
        "recommend": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "quit_point": {
      "type": [
        "string",
        "null"
      ],
      "description": "exact moment the persona would have quit, or null"
    },
    "verbatim": {
      "type": "string"
    },
    "tasks": {
      "type": "object",
      "description": "Optional task completion flags read by kit/evaluate.mjs (feedback adapter, metric task): end_reached (reached the end screen), second_game (started another game), or any task the instance names",
      "additionalProperties": {
        "type": "boolean"
      },
      "properties": {
        "end_reached": {
          "type": "boolean"
        },
        "second_game": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": [
        "value",
        "reason"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
